#!/usr/bin/env bash
# Copy stdin or a file to the clipboard of the local graphical session.
_clipboard_copy() {
  if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy >/dev/null; then
    wl-copy
  elif [[ -n "$DISPLAY" ]] && command -v xclip >/dev/null; then
    xclip -selection clipboard
  else
    echo "copy: no clipboard available (needs wl-copy or xclip)" >&2
    return 1
  fi
}

if [[ ! -t 0 ]]; then
  _clipboard_copy
elif [[ -f "$1" ]]; then
  _clipboard_copy < "$1"
else
  echo "Usage: copy <filename> or <cmd> | copy" >&2
  exit 1
fi
